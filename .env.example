# In Portainer als Stack-Umgebungsvariablen eintragen oder als .env ablegen.

# Login fuers gesamte Dashboard (ausser /api/health). Ohne ADMIN_PASSWORD ist
# der Login deaktiviert und das Dashboard offen erreichbar - unbedingt ein
# starkes Passwort setzen, sobald es im LAN erreichbar ist.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Netzwerk
BIND_ADDRESS=0.0.0.0
HOST_PORT=8086

# I2C
I2C_BUS=0
I2C_ADDRESS=0x69
I2C_TIMEOUT_SECONDS=5
I2C_RETRIES=3

# Regelkreis
CHECK_INTERVAL_SECONDS=15
HISTORY_INTERVAL_SECONDS=300
DETECT_INTERVAL_SECONDS=300
REAPPLY_INTERVAL_SECONDS=300

# Persistenz und Abschaltverhalten
MAX_LOG_LINES=20000
SAFE_SHUTDOWN_PERCENT=0

TZ=Europe/Berlin
