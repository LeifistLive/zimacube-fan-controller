# Add these as Portainer stack environment variables, or save as .env.

# Login for the whole dashboard (except /api/health). Without ADMIN_PASSWORD
# the login is disabled and the dashboard is openly reachable - be sure to
# set a strong password as soon as it is reachable on the LAN.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Network
BIND_ADDRESS=0.0.0.0
HOST_PORT=8086

# I2C
I2C_BUS=0
I2C_ADDRESS=0x69
I2C_TIMEOUT_SECONDS=5
I2C_RETRIES=3

# Control loop
CHECK_INTERVAL_SECONDS=15
HISTORY_INTERVAL_SECONDS=300
DETECT_INTERVAL_SECONDS=300
REAPPLY_INTERVAL_SECONDS=300

# Persistence and shutdown behavior
MAX_LOG_LINES=20000
SAFE_SHUTDOWN_PERCENT=0

TZ=Europe/Berlin
