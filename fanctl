#!/bin/sh
set -eu

RUNTIME_DIR="/run/fan-controller"
COMMAND_FILE="${RUNTIME_DIR}/command"
STATE_FILE="${RUNTIME_DIR}/state"

usage() {
    echo "Verwendung:"
    echo "  fanctl 1-100   Manuelle Geschwindigkeit setzen"
    echo "  fanctl auto    Automatik aktivieren"
    echo "  fanctl status  Status anzeigen"
}

command="${1:-status}"

case "$command" in
    status)
        if [ -r "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            echo "Noch kein Status verfügbar."
            exit 1
        fi
        ;;

    auto)
        printf 'auto\n' > "$COMMAND_FILE"
        echo "Automatik angefordert."
        ;;

    ''|*[!0-9]*)
        usage
        exit 2
        ;;

    *)
        if [ "$command" -lt 1 ] || [ "$command" -gt 100 ]; then
            echo "Prozentwert muss zwischen 1 und 100 liegen." >&2
            exit 2
        fi

        printf '%s\n' "$command" > "$COMMAND_FILE"
        echo "${command}% angefordert."
        ;;
esac