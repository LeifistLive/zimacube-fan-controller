#!/bin/sh
# Kleiner Wrapper um die REST-API, gedacht fuer "docker exec".
set -eu

BASE_URL="${FANCTL_URL:-http://127.0.0.1:8080}"
ADMIN_USER="${ADMIN_USER:-admin}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-}"
COOKIE_FILE="${FANCTL_COOKIE_FILE:-/tmp/fanctl-session}"
COMMAND="${1:-status}"

usage() {
	echo "Usage: fanctl status|health|config|auto|emergency|profile NAME|test PERCENT|1-100" >&2
	exit 2
}

# Loggt sich per HTTP-Basic-Auth ein (derselbe Mechanismus wie die
# Login-Seite) und speichert die resultierende Session-Cookie. Ohne
# ADMIN_PASSWORD ist der Login serverseitig deaktiviert, ein Login-Versuch
# schadet dann nicht, liefert aber auch keine Cookie.
login() {
	wget -qO- --timeout=15 --method=POST --body-data= \
		--header="Authorization: Basic $(printf '%s:%s' "$ADMIN_USER" "$ADMIN_PASSWORD" | base64)" \
		--save-cookies="$COOKIE_FILE" --keep-session-cookies \
		"$BASE_URL/login" >/dev/null 2>&1 || true
}

# request retries once after a fresh login if the cached session is missing
# or has expired, so a stale /tmp/fanctl-session from a previous container
# start does not require the operator to intervene. wget does not write the
# response body for a non-2xx status by default, so a failed first attempt
# cannot have already printed anything, and the retry cannot duplicate output.
request() {
	method="$1"
	path="$2"

	set -- -qO- --timeout=15
	if [ "$method" = "POST" ]; then
		set -- "$@" --method=POST --body-data=
	fi

	[ -f "$COOKIE_FILE" ] || login

	if wget "$@" --load-cookies="$COOKIE_FILE" "$BASE_URL$path" 2>/dev/null; then
		return 0
	fi
	login
	exec wget "$@" --load-cookies="$COOKIE_FILE" "$BASE_URL$path"
}

is_number() {
	case "$1" in
		'' | *[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

case "$COMMAND" in
	status) request GET /api/status ;;
	health) request GET /api/health ;;
	config) request GET /api/config ;;
	auto) request POST /api/mode/auto ;;
	emergency) request POST /api/mode/emergency ;;
	profile)
		[ -n "${2:-}" ] || usage
		request POST "/api/profile/$2"
		;;
	test)
		[ -n "${2:-}" ] || usage
		is_number "$2" || usage
		[ "$2" -ge 1 ] && [ "$2" -le 100 ] || { echo "Prozentwert muss zwischen 1 und 100 liegen" >&2; exit 2; }
		request POST "/api/test/$2"
		;;
	help | -h | --help) usage ;;
	*)
		is_number "$COMMAND" || usage
		[ "$COMMAND" -ge 1 ] && [ "$COMMAND" -le 100 ] || { echo "Prozentwert muss zwischen 1 und 100 liegen" >&2; exit 2; }
		request POST "/api/fan/$COMMAND"
		;;
esac
